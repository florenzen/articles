{
  "[markdown]": {
    "editor.wordWrap": "bounded",
    "editor.wordWrapColumn": 100,
    "editor.rulers": [102]
  },
  "files.associations": {
    "**/templates/**/*.html": "jinja-html",
    ".djlintrc": "json",
    ".nsprc": "json"
  },
  "[jinja-html]": {
    "editor.defaultFormatter": "monosans.djlint"
  },
  "[scss]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[yaml]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[github-actions-workflow]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[toml]": {
    "editor.defaultFormatter": "tamasfe.even-better-toml"
  },
  "[shellscript]": {
    "editor.defaultFormatter": "mkhl.shfmt"
  },
  // Use the tools pinned in requirements-dev.txt, not the versions
  // bundled with the extensions.
  "ruff.path": ["/opt/venv/bin/ruff"],
  "black-formatter.interpreter": ["/opt/venv/bin/python"],
  "black-formatter.importStrategy": "fromEnvironment",
  "shellcheck.executablePath": "/opt/venv/bin/shellcheck",
  "shfmt.executablePath": "/opt/venv/bin/shfmt",
  "hadolint.hadolintPath": "/opt/venv/bin/hadolint",
  "stylelint.validate": ["scss"],
  "cSpell.enabledFileTypes": {
    "*": false,
    "markdown": true
  },
  "cSpell.language": "en,de-DE",
  "cSpell.words": [
    "actionlint",
    "aluminium",
    "Alutec",
    "colour",
    "debian",
    "deburr",
    "Deichselseite",
    "djlint",
    "djlintrc",
    "endraw",
    "exiftool",
    "Fixierungsfüße",
    "haus",
    "Inkscape",
    "Innensechskantschrauben",
    "Körnerpunkt",
    "lightbox",
    "Lorenzen",
    "Moosgummistreifen",
    "nsprc",
    "shfmt",
    "Stoppmutter",
    "Stoppmuttern",
    "taplo",
    "Taplo",
    "Tera",
    "trixie",
    "zola"
  ]
}
